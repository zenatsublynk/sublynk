# Cloudflare Turnstile Secret
# Get this from: npx wrangler turnstile widget create ... (prints sitekey + secret)
# Do NOT set real secrets here or in wrangler.toml. Use: npx wrangler secret put TURNSTILE_SECRET
TURNSTILE_SECRET=<paste-your-turnstile-secret-here>

# Supabase Configuration
SUPABASE_URL=https://nbxipq.supabase.co
SUPABASE_ANON_KEY=<paste-your-supabase-anon-key-here>

# Meta Conversions API (server-side CompleteRegistration for job-alert signups)
# Token is a Worker SECRET, never committed:  npx wrangler secret put META_ACCESS_TOKEN
#   (paste the value stored in sublynk.env.local.txt as META_ACCESS_TOKEN when prompted)
META_ACCESS_TOKEN=<set-via-wrangler-secret-put>
# Optional: set only while validating in Events Manager -> Test Events, then delete for live:
#   npx wrangler secret put META_TEST_EVENT_CODE
META_TEST_EVENT_CODE=<optional-test-events-code>
# Non-secret config (dataset id + graph version) lives in wrangler.toml [vars].
